# Never place real credentials in this file.
LILITH_EXECUTION_MODE=mt5-demo
EDITH_MT5_CONFIRM_DEMO=YES
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

EDITH_MT5_SYMBOL=XAUUSDm
EDITH_MT5_TIMEFRAME=M5
EDITH_MT5_LOT=0.01
EDITH_MT5_POLL_SECONDS=15
EDITH_MT5_FAST_PERIOD=5
EDITH_MT5_SLOW_PERIOD=20
EDITH_MT5_STOP_ATR=1.5
EDITH_MT5_TARGET_ATR=1.0
EDITH_MT5_MAX_POSITIONS=1
EDITH_MT5_MAGIC=260729
EDITH_MT5_DEVIATION=20

# Independent execution risk gates.
EDITH_MT5_MAX_RISK_CASH=1.00
EDITH_MT5_MAX_RISK_PCT=2.0
EDITH_MT5_MAX_DAILY_LOSS=5.00
EDITH_MT5_MAX_DRAWDOWN_PCT=10.0
EDITH_MT5_MIN_MARGIN_LEVEL=300
EDITH_MT5_MAX_SPREAD_POINTS=80

# Advisory Portfolio Intelligence daily-risk ledger.
# These values do not change sizing, reject orders, or alter execution.
# Cash defaults to EDITH_MT5_MAX_DAILY_LOSS when omitted.
EDITH_PORTFOLIO_DAILY_BUDGET_CASH=5.00
EDITH_PORTFOLIO_DAILY_BUDGET_R=2.0
EDITH_PORTFOLIO_CURRENCY=USD
EDITH_DAILY_RISK_LATEST_PATH=data/portfolio/latest_daily_risk.json

# Optional operational controls.
EDITH_MT5_MAX_ITERATIONS=0
EDITH_HEARTBEAT_STALE_SECONDS=45
